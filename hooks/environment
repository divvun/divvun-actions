#!/bin/bash
set -ueo pipefail

PLUGIN_DIR=$(realpath $(dirname "${BASH_SOURCE[0]}")/..)

is_commit_hash() {
  echo "$1" | grep -qE '^[0-9a-f]{7,40}$'
}

plugin_ref() {
  echo "${BUILDKITE_PLUGINS:-}" | sed -n 's/.*divvun-actions\.git#\([^"]*\).*/\1/p'
}

# Buildkite caches plugin checkouts and doesn't re-fetch branches.
# When the ref is a branch name, fetch the latest so we're never stale.
PLUGIN_REF=$(plugin_ref)

if [[ -n "$PLUGIN_REF" ]] && ! is_commit_hash "$PLUGIN_REF"; then
  echo "Updating divvun-actions plugin to latest '$PLUGIN_REF'..."
  git -C "$PLUGIN_DIR" clean -ffxdq
  git -C "$PLUGIN_DIR" fetch -v --prune -- origin "$PLUGIN_REF"
  git -C "$PLUGIN_DIR" checkout -f FETCH_HEAD
  git -C "$PLUGIN_DIR" clean -ffxdq
fi

export DIVVUN_ACTIONS_PLUGIN_DIR=$PLUGIN_DIR
export PATH="$PLUGIN_DIR/bin:$PATH"

# Nest each pipeline's checkout one level deeper, in a directory of its own.
# The giella lang builds resolve their sibling dependencies at ../ --
# giella-core, shared-*, other lang repos, the speller corpora -- and under
# Buildkite's default layout that parent is shared by every pipeline on the
# agent. lang-sma updating ../lang-sme as a dependency would then mutate the
# lang-sme pipeline's own checkout, possibly mid-build. With the extra level,
# ../ belongs to this pipeline alone. First build after this change re-clones
# the repo and its dependencies; the old flat checkouts are left behind and
# can be deleted from the agents at leisure.
if [[ -n "${BUILDKITE_BUILD_CHECKOUT_PATH:-}" && -n "${BUILDKITE_REPO:-}" ]]; then
  repo_basename=$(basename "${BUILDKITE_REPO%.git}")
  export BUILDKITE_BUILD_CHECKOUT_PATH="${BUILDKITE_BUILD_CHECKOUT_PATH}/${repo_basename}"
fi

if [[ "$(uname)" == "Darwin" ]]; then
  # Ensure that the PATH is set correctly for macOS
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi

# Set tmpdir to something we control
export TMPDIR=$(mktemp -d -t build.${BUILDKITE_PIPELINE_NAME}.${BUILDKITE_BUILD_NUMBER}.XXXXXXXXXX)
echo "Using temporary directory: $TMPDIR"

echo "Bash"
echo $PATH