{
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env index.ts",
    "docker:gen": "deno run --allow-read --allow-write --allow-env docker/generate.ts",
    "docker:check": "deno run --allow-read --allow-env docker/generate.ts --check",
    "docker:list": "deno run --allow-read --allow-env docker/generate.ts --list",
    "docker:audit": "deno run --allow-net --allow-env docker/audit.ts"
  },
  "compilerOptions": {
    "lib": ["deno.unstable", "deno.ns", "dom"],
    "types": ["./deno.d.ts"],
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ],
      "include": [
        "no-console",
        "no-unused-vars",
        "no-debugger",
        "no-eval",
        "require-await"
      ]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "imports": {
    "@david/which": "jsr:@david/which@^0.8.0",
    "@divvun/iso639": "npm:@divvun/iso639@^0.1.0",
    "@openbao/api": "jsr:@openbao/api@^0.0.3",
    "@std/async": "jsr:@std/async@^1.5.1",
    "@std/cache": "jsr:@std/cache@^0.2.4",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@std/streams": "jsr:@std/streams@^1.2.0",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/uuid": "jsr:@std/uuid@^1.1.2",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "ajv": "npm:ajv@^8.20.0",
    "badge-maker": "npm:badge-maker@^6.0.0",
    "emoji": "jsr:@denosaurs/emoji@^0.3.1",
    "yaml": "npm:yaml@^2.9.1",
    "~/": "./"
  }
}
