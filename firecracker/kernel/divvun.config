# Merged over Firecracker's microvm-kernel-ci-x86_64-6.18.config. The build
# fails if any option here does not survive `make olddefconfig`.

# Root filesystem: the image is an erofs, overlaid on a scratch ext4.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# SendCtrlAltDel, which is how the host asks a guest to finish its job and
# shut down.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# dockerd. The base config has most of what moby's check-config.sh asks
# for; these are the rest. Ubuntu's iptables is the nft flavour, so
# ip6tables needs nf_tables for IPv6 even though the VMs only route IPv4.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# /proc/config.gz, so a job can check what it is running on.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
